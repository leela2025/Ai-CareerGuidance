# -------------------------------------------------------------
# CareerCompassAI — Backend Environment Configuration
# -------------------------------------------------------------

# Server Port & Environment
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection String
# Replace <username>, <password>, and cluster domain with your MongoDB Atlas details
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/careercompassai?retryWrites=true&w=majority

# JWT Authentication Secret
JWT_SECRET=career_compass_ai_jwt_super_secret_production_key_2026

# Anthropic Claude API Key (Model: claude-sonnet-4-6)
# Get key from https://console.anthropic.com/
ANTHROPIC_API_KEY=sk-ant-api03-your-actual-anthropic-api-key-here

# Allowed Frontend Client Origin
CLIENT_URL=http://localhost:5173
