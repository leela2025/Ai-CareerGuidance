    {
      "name": "8. Lifelong Career Navigator Module",
      "item": [
        {
          "name": "1. Start Lifelong Career Journey",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"forceRestart\": false\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/journey/start",
              "host": ["{{baseUrl}}"],
              "path": ["journey", "start"]
            },
            "description": "Initializes user lifelong career journey using their profile lifeStage to formulate the first decision point and 3-5 alternative paths."
          }
        },
        {
          "name": "2. Get Full Journey Tree & History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/journey",
