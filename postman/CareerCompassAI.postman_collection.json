            },
            "description": "Fetches full ongoing career journey with all stages, decision points, chosen paths, and historical branches."
          }
        },
        {
          "name": "3. Commit to Path & Advance to Next Stage",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
