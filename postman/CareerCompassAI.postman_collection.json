    {
      "name": "10. Mentors & Messaging",
      "description": "Unified Mentor Connect & Chat layer. Real-time chat is powered by Socket.IO (join-conversation, send-message, typing, mark-read) with fallback REST endpoints.",
      "item": [
        {
          "name": "1. List Mentors (Filter by type, tag, verified)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mentors?type=expert&verified=true",
              "host": ["{{baseUrl}}"],
              "path": ["mentors"],
              "query": [
                { "key": "type", "value": "expert" },
                { "key": "verified", "value": "true" }
              ]
            },
            "description": "Public directory of mentors filterable by type (expert | peer), tags, and verification status."
          }
        },
        {
          "name": "2. Get Mentor Profile by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/mentors/{{mentorId}}",
              "host": ["{{baseUrl}}"],
              "path": ["mentors", "{{mentorId}}"]
            },
            "description": "Fetches full mentor profile with bio, rating, total conversations, and past learner reviews."
          }
        },
        {
          "name": "3. Apply to Become a Mentor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"type\": \"peer\",\n  \"headline\": \"Switched from Mechanical to Full-Stack Web Development\",\n  \"bio\": \"Self-taught developer who cracked product-based startup interviews after 8 months of consistent building. Happy to review projects and share motivation!\",\n  \"companyOrCollege\": \"TechVentures Ltd\",\n  \"yearsOfExperience\": 2,\n  \"availability\": \"Weekday evenings 8-10 PM\",\n  \"expertiseTags\": [\"career-switch\", \"mern-stack\", \"resume-review\", \"projects\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mentors/apply",
              "host": ["{{baseUrl}}"],
              "path": ["mentors", "apply"]
            },
            "description": "Allows a registered user to apply as a peer motivator (auto-approved) or expert (admin review)."
          }
        },
        {
          "name": "4. Verify Expert Mentor (Admin Only)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{adminToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"verified\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/admin/mentors/{{mentorId}}/verify",
              "host": ["{{baseUrl}}"],
              "path": ["admin", "mentors", "{{mentorId}}", "verify"]
            },
            "description": "Admin endpoint to review and officially verify an expert mentor's credentials."
          }
        },
        {
          "name": "5. Send Connection Request to Mentor",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"mentorId\": \"{{mentorId}}\",\n  \"message\": \"Hello! I am a 3rd year student aiming for a cloud architecture role. I would love 15 minutes of guidance on which AWS certs actually matter for entry-level hiring.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/connections/request",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "request"]
            },
            "description": "Sends a connection request with introductory note. Rate-limited to prevent spam."
          }
        },
        {
          "name": "6. Get My Connections (Sent & Incoming)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/connections/mine",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "mine"]
            },
            "description": "Returns both sent requests (for learners) and incoming requests (for mentors) with status and conversation IDs."
          }
        },
        {
          "name": "7. Respond to Connection Request (Accept/Decline)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{mentorToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"accepted\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/connections/{{connectionRequestId}}/respond",
              "host": ["{{baseUrl}}"],
              "path": ["connections", "{{connectionRequestId}}", "respond"]
            },
            "description": "Mentor accepts or declines. On accept, automatically provisions a Conversation room."
          }
        },
        {
          "name": "8. Get Conversation & Message History",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}"]
            },
            "description": "Fetches messages for the conversation. Strictly enforces participant authorization."
          }
        },
        {
          "name": "9. Post Message Fallback (REST)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"text\": \"Thank you so much! That makes complete sense. I will start preparing for the SAA-C03 exam.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/conversations/{{conversationId}}/messages",
              "host": ["{{baseUrl}}"],
              "path": ["conversations", "{{conversationId}}", "messages"]
            },
            "description": "REST fallback endpoint for sending messages if WebSocket connection is unavailable."
          }
        },
        {
          "name": "10. Submit Mentor Feedback & Rating",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"conversationId\": \"{{conversationId}}\",\n  \"rating\": 5,\n  \"comment\": \"Exceptional guidance! Helped me streamline my portfolio and gave me clear realistic expectations.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/mentors/{{mentorId}}/feedback",
              "host": ["{{baseUrl}}"],
              "path": ["mentors", "{{mentorId}}", "feedback"]
            },
            "description": "Allows mentee to rate (1-5) and review their mentor, automatically updating average rating."
          }
        }
      ]
    },
    {
      "name": "11. Feedback & Stories Module",
      "description": "Platform-wide feedback ratings and moderated community success stories.",
      "item": [
        {
          "name": "1. Submit or Update Platform Feedback",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"overallRating\": 5,\n  \"featureRatings\": {\n    \"aiAccuracy\": 5,\n    \"roadmapUsefulness\": 5,\n    \"uiExperience\": 5\n  },\n  \"comment\": \"CareerCompassAI gave me the structured weekly checkpoints I needed to build my cloud portfolio and clear tech interviews.\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/feedback/platform",
              "host": ["{{baseUrl}}"],
              "path": ["feedback", "platform"]
            },
            "description": "Submits overall 1-5 rating, optional feature ratings, and comment. Automatically updates if submitted within 30 days."
          }
