{
  "info": {
    "_postman_id": "7f8b9190-3456-42d1-b51c-8e0c9f134567",
    "name": "CareerCompassAI API Collection",
    "description": "Complete production API test suite for CareerCompassAI - AI-powered career guidance, skill gap analysis, personalized roadmaps, and resume evaluation using Claude Sonnet 4.6.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5000/api",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Authentication Module",
      "item": [
        {
          "name": "Register Student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Alex Chen\",\n  \"email\": \"alex.chen@university.edu\",\n  \"password\": \"Student@123\",\n  \"role\": \"student\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            },
            "description": "Registers a new student user and returns JWT token."
          }
        },
        {
          "name": "Login (Auto-Saves Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved token to collection variable: \" + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"student@careercompass.ai\",\n  \"password\": \"Student@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates user and auto-saves the received JWT token to the {{token}} collection variable."
          }
        },
        {
          "name": "Login as Admin (Auto-Saves Admin Token)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "if (jsonData.token) {",
                  "    pm.collectionVariables.set(\"token\", jsonData.token);",
                  "    console.log(\"Saved Admin token to collection variable: \" + jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@careercompass.ai\",\n  \"password\": \"Admin@123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticates admin user to test admin protected analytics endpoints."
          }
        },
        {
          "name": "Get Current User Profile (Me)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/me",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "me"]
            },
            "description": "Returns currently authenticated user session details."
          }
        }
      ]
    },
    {
      "name": "2. Profile Module",
      "item": [
        {
          "name": "Get Student Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            },
            "description": "Fetches current student profile details."
          }
        },
        {
          "name": "Update Student Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"educationLevel\": \"B.Tech / B.E.\",\n  \"branch\": \"Computer Science & Engineering\",\n  \"graduationYear\": \"2026\",\n  \"currentSkills\": [\"JavaScript\", \"React\", \"Node.js\", \"Express\", \"MongoDB\", \"Git\"],\n  \"interests\": [\"Full Stack Development\", \"Cloud Architecture\", \"Generative AI\"],\n  \"resumeText\": \"Alex Chen - Aspiring Full Stack Cloud Engineer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/profile",
              "host": ["{{baseUrl}}"],
              "path": ["profile"]
            },
            "description": "Updates degree, branch, current technical skills, and career interests."
          }
        }
      ]
    },
    {
      "name": "3. AI Career Guidance Module",
      "item": [
        {
          "name": "Analyze Career Paths (Claude AI)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"customGoal\": \"Full Stack Cloud Developer\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/career/analyze",
              "host": ["{{baseUrl}}"],
              "path": ["career", "analyze"]
            },
            "description": "Prompts Claude Sonnet 4.6 with student profile to recommend 3-5 career trajectories and prioritize skill gaps."
          }
        },
        {
          "name": "Get Career Suggestions History",
          "request": {
            "method": "GET",
            "header": [
