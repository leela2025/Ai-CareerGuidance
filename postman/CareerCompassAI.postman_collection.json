            "body": {
              "mode": "raw",
              "raw": "{\n  \"careerGoal\": \"Full Stack Cloud Developer\",\n  \"skillGaps\": [\"Docker\", \"Kubernetes\", \"TypeScript\", \"AWS\", \"System Design\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roadmap/generate",
              "host": ["{{baseUrl}}"],
              "path": ["roadmap", "generate"]
