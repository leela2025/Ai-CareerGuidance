          "name": "Update Milestone Status",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{token}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"completed\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/roadmap/ts-01",
              "host": ["{{baseUrl}}"],
              "path": ["roadmap", "ts-01"]
            },
            "description": "Updates milestone status ('pending' | 'in-progress' | 'completed') and recalculates overall progress %."
          }
        }
      ]
    },
