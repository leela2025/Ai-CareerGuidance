            "url": {
              "raw": "{{baseUrl}}/career/suggestions",
              "host": ["{{baseUrl}}"],
              "path": ["career", "suggestions"]
            },
            "description": "Fetches past career suggestions and gap analyses."
          }
        }
      ]
    },
    {
      "name": "4. Roadmap Module",
      "item": [
