        {
          "name": "2. Get Platform Feedback Summary (Public)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/feedback/platform/summary",
              "host": ["{{baseUrl}}"],
              "path": ["feedback", "platform", "summary"]
            },
            "description": "Returns aggregated platform metrics (average rating, count, distribution, per-feature averages) for landing page display."
          }
        },
        {
          "name": "3. Get My Platform Feedback",
